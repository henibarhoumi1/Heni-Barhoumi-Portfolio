{
  "name": "heni-barhoumi-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Personal site of Heni Barhoumi. Static build, deployed on Cloudflare.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx build/dev.ts",
    "build": "tsx build/build.ts",
    "preview": "tsx build/serve.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "wrangler": "^4.0.0"
  }
}
