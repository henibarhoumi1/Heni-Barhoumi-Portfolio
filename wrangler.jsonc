{
  // Cloudflare Workers, static assets only. No server code runs.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heni-barhoumi",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
